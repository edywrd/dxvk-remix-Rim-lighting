@@ -871,6 +871,17 @@ OpaqueSurfaceMaterialInteraction opaqueSurfaceMaterialInteractionCreate(
 
   opaqueSurfaceMaterialInteraction.emissiveRadiance = emissiveBlendOverrideInfluence * emissiveColor * opaqueSurfaceMaterial.emissiveIntensity;
 
+  // Add a view-dependent rim term on surfaces tagged for it. This is a stylized effect rather than a physical one,
+  // so it is added as emission to keep it independent of the lighting around the surface.
+  if (cb.opaqueMaterialArgs.rimLightEnable && surface.isRimLight && !surface.isMatte)
+  {
+    const float normalDotView = saturate(dot(vec3(opaqueSurfaceMaterialInteraction.shadingNormal), minimalRayInteraction.viewDirection));
+    const float rimFactor = pow(1.0f - normalDotView, cb.opaqueMaterialArgs.rimLightExponent);
+    const vec3 rimTint = lerp(vec3(1.0f), vec3(albedo), cb.opaqueMaterialArgs.rimLightAlbedoTint);
+
+    opaqueSurfaceMaterialInteraction.emissiveRadiance += cb.opaqueMaterialArgs.rimLightRadiance * rimTint * rimFactor * opacity;
+  }
+
   opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction =
     subSurfaceMaterialReadHelper(opaqueSurfaceMaterial.subsurfaceMaterialIndex, surfaceInteraction, opaqueSurfaceMaterial.samplerIndex);
 
