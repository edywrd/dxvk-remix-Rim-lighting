+struct RimLightOptions {
+  friend class ImGUI;
+
+  RTX_OPTION("rtx.rimLight", bool, enable, true,
+             "A flag to enable the rim light term on opaque materials.\n"
+             "Only draw calls with a texture in rtx.rimLightTextures receive the rim light.");
+  RTX_OPTION("rtx.rimLight", Vector3, color, Vector3(1.0f, 1.0f, 1.0f), "The color of the rim light added to tagged opaque materials.");
+  RTX_OPTION("rtx.rimLight", float, intensity, 1.0f,
+             "The intensity of the rim light, applied the same way as an emissive intensity.\n"
+             "Set to 0 to disable the rim light without clearing the texture list.");
+  RTX_OPTION("rtx.rimLight", float, exponent, 4.0f,
+             "The exponent applied to (1 - N.V) when evaluating the rim light.\n"
+             "Higher values make the rim thinner and keep it closer to the silhouette.");
+  RTX_OPTION("rtx.rimLight", float, albedoTint, 0.0f,
+             "How much the rim light color is multiplied by the surface albedo, from 0 (rim color only) to 1 (rim color times albedo).");
+
+public:
+  static void fillShaderParams(OpaqueMaterialArgs& args) {
+    const float rimIntensity = std::max(intensity(), 0.0f);
+
+    args.rimLightEnable = enable() && rimIntensity > 0.0f;
+    args.rimLightExponent = std::max(exponent(), 0.01f);
+    args.rimLightAlbedoTint = std::clamp(albedoTint(), 0.0f, 1.0f);
+    args.rimLightRadiance = vec3(color()) * rimIntensity;
+  }
+};
+
 struct TranslucentMaterialOptions {
   friend class ImGUI;
 
